//SYSIN    DD *
CREATE TABLE BANK.CUSTOMER (
  CUST_ID   INTEGER NOT NULL,
  CUST_NAME VARCHAR(40),
  PRIMARY KEY (CUST_ID));
CREATE TABLE AUDIT_LOG (
  ID        INTEGER NOT NULL,
  CUST_ID   INTEGER NOT NULL,
  AGE       SMALLINT NOT NULL WITH DEFAULT,
  CONSTRAINT AUDIT_PK PRIMARY KEY (ID),
  FOREIGN KEY (CUST_ID) REFERENCES BANK.CUSTOMER (CUST_ID) ON DELETE CASCADE);
CREATE INDEX BANK.AUDIT_CUST ON AUDIT_LOG (CUST_ID);
CREATE VIEW BANK.CUSTOMER_AUDIT AS
  SELECT C.CUST_NAME, A.AGE FROM BANK.CUSTOMER C, AUDIT_LOG A
  WHERE C.CUST_ID = A.CUST_ID;
/*
