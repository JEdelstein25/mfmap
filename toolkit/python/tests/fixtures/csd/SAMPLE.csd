 DEFINE PROGRAM(SAMPLE) GROUP(SAMPGRP)
 DEFINE TRANSACTION(SAMP) GROUP(SAMPGRP)
        DESCRIPTION(SAMPLE ACCOUNT INQUIRY)
        PROGRAM(SAMPLE) TWASIZE(0)
 DEFINE FILE(ACCTFIL) GROUP(SAMPGRP)
        DSNAME(PROD.SAMPLE.ACCOUNTS) RLSACCESS(NO)
 DEFINE DB2ENTRY(SAMPENT) GROUP(SAMPGRP)
        PLAN(SAMPPLN)
 DEFINE DB2TRAN(SAMPTRAN) GROUP(SAMPGRP)
        ENTRY(SAMPENT) TRANSID(SAMP)
 DEFINE TDQUEUE(JOBS) GROUP(SAMPGRP)
        DESCRIPTION(SUBMIT JOBS) TYPE(EXTRA) DDNAME(INREADER)
