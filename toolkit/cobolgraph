# Run cobolgraph from this checkout without installing it, with the server.jar this checkout builds.
dir=$(cd "$(dirname "$0")" && pwd)
export PARSEBOL_JAR="${PARSEBOL_JAR:-$dir/../server/engine/target/server.jar}"
PYTHONPATH="$dir/python${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m cobolgraph "$@"
