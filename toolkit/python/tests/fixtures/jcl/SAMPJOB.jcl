//SAMPJOB  JOB 'Nightly sample run',CLASS=A,MSGCLASS=0,
//             NOTIFY=&SYSUID
//* Runs SAMPLE through TSO batch, as Db2 batch programs are run
//STEP10   EXEC PGM=IKJEFT01
//ACCTDD   DD DISP=SHR,
//            DSN=PROD.SAMPLE.ACCOUNTS
//RPTDD    DD DSN=PROD.SAMPLE.REPORT(+1),DISP=(NEW,CATLG)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(SAMPLE) PLAN(SAMPPLN)
/*
//STEP20   EXEC PROC=SAMPPROC
